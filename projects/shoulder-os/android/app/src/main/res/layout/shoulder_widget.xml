<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_previous" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="24sp" />
        <TextView android:id="@+id/widget_month_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="2026.09" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="↻" android:textColor="#A9D8C9" android:textSize="18sp" />
        <TextView android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#A9D8C9" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#A9D8C9" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#A9D8C9" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="#A9D8C9" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="#A9D8C9" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="토" android:textColor="#78B7FF" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="#FF918B" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_workout" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="운동" android:textSize="10sp" />
        <Button android:id="@+id/widget_rehab" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="BEST 6" android:textSize="10sp" />
        <Button android:id="@+id/widget_pain" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="통증" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
